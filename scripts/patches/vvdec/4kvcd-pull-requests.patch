index 7336c4f..96b08c1 100644
--- a/source/Lib/CommonLib/x86/LoopFilterX86.h
+++ b/source/Lib/CommonLib/x86/LoopFilterX86.h
@@ -853,11 +853,177 @@ static void xFilteringPandQX86( Pel* src, ptrdiff_t step, const ptrdiff_t offset
