+static bool check_scaleSignal( PelBufferOps* ref, PelBufferOps* opt, unsigned num_cases )
+{
+  DimensionGenerator rng;
+  InputGenerator<Pel> g{ 16 };   // residuals of any 16 bit value, so that the clipping is tested too
