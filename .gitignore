.venv/
__pycache__/
*.pyc
*.vmafrun.json

# throwaway benchmark/QA scratch space (includes sample .mp4s)
tests_scratch/
# stdout/stderr captured from launching the GUI
gui_stdout.log
gui_stderr.log
# The native libraries, built from native/ by the scripts' build_*.ps1
resources/native/*.dll
# macOS's tools, built by scripts/build_*_macos.sh (the release script runs them)
resources/tools/libvmaf/libvmaf.dylib
resources/tools/libjxl/ssimulacra2
resources/tools/libjxl/butteraugli_main
resources/tools/ffmpeg/*.dylib
resources/tools/vulkan/
resources/tools/vship/vulkan/libvship.dylib
resources/tools/vship/vship51/libvship.dylib
resources/tools/vmaf_vulkan/vmaf_vulkan.dylib
