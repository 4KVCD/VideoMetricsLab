{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/4KVCD/VideoMetricsLab/blob/release/v2.7/docs/schemas/segments-report.schema.json",
  "title": "VideoMetricsLab weak segments report (segments-report-1)",
  "description": "Every video's weak segments in one file: compare --segments-report and the window's exports.",
  "type": "object",
  "required": [
    "app",
    "version",
    "commit",
    "format",
    "conditions",
    "combine",
    "min_frames",
    "merge_frames",
    "videos"
  ],
  "properties": {
    "app": {
      "const": "VideoMetricsLab"
    },
    "version": {
      "type": "string"
    },
    "commit": {
      "type": "string"
    },
    "format": {
      "const": "segments-report-1"
    },
    "conditions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "combine": {
      "enum": [
        "any",
        "all"
      ]
    },
    "min_frames": {
      "type": "integer"
    },
    "merge_frames": {
      "type": "integer"
    },
    "videos": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "path",
          "reference",
          "segment_count",
          "weak_frames",
          "segments"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "reference": {
            "type": "string"
          },
          "segment_count": {
            "type": "integer"
          },
          "weak_frames": {
            "type": "integer"
          },
          "left_out": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "segments": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/segment"
            }
          }
        }
      }
    }
  },
  "$defs": {
    "segment": {
      "type": "object",
      "required": [
        "first_frame",
        "last_frame",
        "start_time",
        "end_time",
        "frames",
        "metrics"
      ],
      "properties": {
        "first_frame": {
          "type": "integer"
        },
        "last_frame": {
          "type": "integer"
        },
        "start_time": {
          "type": "number"
        },
        "end_time": {
          "type": "number"
        },
        "frames": {
          "type": "integer"
        },
        "metrics": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": [
              "min",
              "max",
              "mean"
            ],
            "properties": {
              "min": {
                "anyOf": [
                  {
                    "type": "number"
                  },
                  {
                    "enum": [
                      "inf",
                      "-inf"
                    ]
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "max": {
                "anyOf": [
                  {
                    "type": "number"
                  },
                  {
                    "enum": [
                      "inf",
                      "-inf"
                    ]
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "mean": {
                "anyOf": [
                  {
                    "type": "number"
                  },
                  {
                    "enum": [
                      "inf",
                      "-inf"
                    ]
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          }
        }
      }
    }
  }
}
