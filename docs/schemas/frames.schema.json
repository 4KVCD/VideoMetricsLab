{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/4KVCD/VideoMetricsLab/blob/release/v2.7/docs/schemas/frames.schema.json",
  "title": "VideoMetricsLab per-frame scores (frames-1)",
  "description": "A video's per-frame scores: compare --frames-json and the window's exports. Each row is the CSV's, its cells in the order of columns.",
  "type": "object",
  "required": [
    "app",
    "version",
    "commit",
    "format",
    "reference",
    "test",
    "fps",
    "columns",
    "rows"
  ],
  "properties": {
    "app": {
      "const": "VideoMetricsLab"
    },
    "version": {
      "type": "string"
    },
    "commit": {
      "type": "string"
    },
    "format": {
      "const": "frames-1"
    },
    "reference": {
      "type": "string"
    },
    "test": {
      "type": "string"
    },
    "fps": {
      "type": "number"
    },
    "columns": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "rows": {
      "type": "array",
      "items": {
        "type": "array",
        "items": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "enum": [
                "inf",
                "-inf"
              ]
            },
            {
              "type": "null"
            }
          ]
        }
      }
    }
  }
}
