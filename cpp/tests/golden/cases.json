{
  "about": "Command-line runs that cover the ways the app scores videos. `golden.py run` runs each with a fresh profile (no settings, no saved scores); `golden.py compare` holds two apps' results to each other.",
  "cases": [
    { "name": "libvmaf-cpu-4k", "reference": "videoq_src.mp4", "tests": ["videoq_4k_h265.mkv"],
      "args": ["-m", "vmaf,vmaf_neg,psnr,ssim,xpsnr", "--vmaf-on", "cpu", "--frames", "60"] },
    { "name": "libvmaf-cpu-v1-scaled-to-test", "reference": "videoq_src.mp4", "tests": ["videoq_1080p_h265.mkv"],
      "args": ["-m", "vmaf,vmaf_v1,ssim", "--vmaf-on", "cpu", "--frames", "60"] },
    { "name": "libvmaf-cpu-scaled-to-reference", "reference": "videoq_src.mp4", "tests": ["videoq_1080p_h265.mkv"],
      "args": ["-m", "vmaf,psnr,xpsnr", "--vmaf-on", "cpu", "--scale-to", "reference", "--scaler", "lanczos",
               "--frames", "30"] },
    { "name": "libvmaf-cpu-options", "reference": "videoq_src.mp4", "tests": ["videoq_4k_h265.mkv"],
      "args": ["-m", "vmaf,xpsnr", "--vmaf-on", "cpu", "--model", "4k", "--subsample", "3", "--duration", "1.0",
               "--black-bars", "none"] },
    { "name": "libvmaf-cpu-pattern", "reference": "honeybee_src.mkv", "tests": ["honeybee_*.mkv"],
      "args": ["-m", "vmaf,vmaf_neg,psnr,ssim,xpsnr", "--vmaf-on", "cpu", "--frames", "120"] },
    { "name": "libvmaf-cpu-software-decode", "reference": "videoq_src.mp4", "tests": ["videoq_1080p_vvc.mkv"],
      "args": ["-m", "vmaf,psnr", "--cpu", "--no-gpu-decode", "--frames", "60"] },
    { "name": "libvmaf-cpu-timestamp-pairing", "reference": "videoq_src.mp4", "tests": ["videoq_4k_h265.mkv"],
      "args": ["-m", "vmaf,psnr", "--vmaf-on", "cpu", "--frames", "60"],
      "environment": { "VML_FRAME_PAIRING": "timestamp" } },
    { "name": "libvmaf-cpu-unreadable", "reference": "videoq_src.mp4", "tests": ["videoq_4k_h265.mkv", "missing.mkv"],
      "args": ["-m", "vmaf", "--vmaf-on", "cpu", "--frames", "10"] },
    { "name": "vmaf-gpu-4k", "reference": "videoq_src.mp4", "tests": ["videoq_4k_h265.mkv"],
      "args": ["-m", "vmaf,vmaf_neg,vmaf_v1", "--vmaf-on", "gpu"] },
    { "name": "vmaf-neg-gpu-scaled-by-ffmpeg", "reference": "videoq_src.mp4", "tests": ["videoq_1080p_h265.mkv"],
      "args": ["-m", "vmaf,vmaf_neg", "--no-gpu-decode", "--frames", "60"],
      "environment": { "VML_SOFTWARE_DECODE": "ffmpeg" } },
    { "name": "vmaf-gpu-pattern", "reference": "honeybee_src.mkv", "tests": ["honeybee_*.mkv"],
      "args": ["-m", "vmaf,vmaf_neg", "--frames", "120"] },
    { "name": "vmaf-neg-gpu-scaled", "reference": "videoq_src.mp4", "tests": ["videoq_1080p_h265.mkv"],
      "args": ["-m", "vmaf,vmaf_neg", "--frames", "60"] },
    { "name": "vmaf-gpu-vvc-software-decode", "reference": "videoq_src.mp4", "tests": ["videoq_1080p_vvc.mkv"],
      "args": ["-m", "vmaf,vmaf_neg", "--frames", "60"] },
    { "name": "vmaf-gpu-no-gpu-decode", "reference": "videoq_src.mp4", "tests": ["videoq_4k_h265.mkv"],
      "args": ["-m", "vmaf,vmaf_neg", "--no-gpu-decode", "--frames", "60"] },
    { "name": "cpu-metrics-in-app", "reference": "videoq_src.mp4", "tests": ["videoq_4k_h265.mkv"],
      "args": ["-m", "psnr,ssim,xpsnr", "--frames", "60"] },
    { "name": "cpu-metrics-pattern", "reference": "honeybee_src.mkv", "tests": ["honeybee_*.mkv"],
      "args": ["-m", "psnr,ssim,xpsnr", "--frames", "120"] },
    { "name": "cpu-metrics-scaled-by-ffmpeg", "reference": "videoq_src.mp4", "tests": ["videoq_1080p_h265.mkv"],
      "args": ["-m", "psnr,ssim", "--subsample", "2", "--frames", "60"] },
    { "name": "vmaf-gpu-beside-cpu-metrics", "reference": "videoq_src.mp4", "tests": ["videoq_4k_h265.mkv"],
      "args": ["-m", "vmaf,vmaf_neg,psnr,ssim,xpsnr", "--frames", "60"] },
    { "name": "vmaf-gpu-beside-xpsnr-subsampled", "reference": "videoq_src.mp4", "tests": ["videoq_4k_h265.mkv"],
      "args": ["-m", "vmaf,xpsnr", "--subsample", "2", "--frames", "60"] },
    { "name": "vmaf-gpu-beside-cpu-metrics-pattern", "reference": "honeybee_src.mkv", "tests": ["honeybee_*.mkv"],
      "args": ["-m", "vmaf,psnr,ssim", "--frames", "120"] },
    { "name": "vship-gpu-4k", "reference": "videoq_src.mp4", "tests": ["videoq_4k_h265.mkv"],
      "args": ["-m", "ssimulacra2,butteraugli,cvvdp"] },
    { "name": "perceptual-cpu-4k", "reference": "videoq_src.mp4", "tests": ["videoq_4k_h265.mkv"],
      "args": ["-m", "ssimulacra2,butteraugli", "--cpu", "--frames", "12"] },
    { "name": "scaled-to-test", "reference": "videoq_src.mp4", "tests": ["videoq_1080p_h265.mkv"],
      "args": ["-m", "vmaf,psnr,ssimulacra2"] },
    { "name": "scaled-to-reference", "reference": "videoq_src.mp4", "tests": ["videoq_1080p_h265.mkv"],
      "args": ["-m", "vmaf,psnr", "--scale-to", "reference", "--scaler", "lanczos", "--frames", "60"] },
    { "name": "vvc-software-decode", "reference": "videoq_src.mp4", "tests": ["videoq_1080p_vvc.mkv"],
      "args": ["-m", "vmaf,psnr,cvvdp"] },
    { "name": "no-gpu-decode", "reference": "videoq_src.mp4", "tests": ["videoq_4k_h265.mkv"],
      "args": ["-m", "vmaf,ssimulacra2", "--no-gpu-decode", "--frames", "60"] },
    { "name": "options", "reference": "videoq_src.mp4", "tests": ["videoq_4k_h265.mkv"],
      "args": ["-m", "vmaf", "--model", "4k", "--subsample", "3", "--duration", "1.0", "--black-bars", "none"] },
    { "name": "two-tests-sdr", "reference": "honeybee_src.mkv", "tests": ["honeybee_h264.mkv", "honeybee_h265.mkv"],
      "args": ["-m", "vmaf,psnr,ssim,xpsnr,ssimulacra2", "--frames", "120"] },
    { "name": "colour-and-displays", "reference": "honeybee_src.mkv", "tests": ["honeybee_h265.mkv"],
      "args": ["-m", "psnr,cvvdp", "--colour", "bt709", "--cvvdp-display", "30-inch 4K monitor, office",
               "--cvvdp-display", "6-inch phone"] },
    { "name": "timestamp-pairing", "reference": "videoq_src.mp4", "tests": ["videoq_4k_h265.mkv"],
      "args": ["-m", "vmaf,psnr,ssimulacra2", "--frames", "60"], "environment": { "VML_FRAME_PAIRING": "timestamp" } }
  ]
}
