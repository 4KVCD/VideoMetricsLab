{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/${presetName}"
    },
    {
      "name": "windows",
      "inherits": "base",
      "displayName": "Windows (MSVC)",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    },
    {
      "name": "linux",
      "inherits": "base",
      "displayName": "Linux (GCC)",
      "generator": "Ninja Multi-Config",
      "cacheVariables": { "CMAKE_CXX_COMPILER": "g++" },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" }
    },
    {
      "name": "linux-sanitizers",
      "inherits": "linux",
      "displayName": "Linux (GCC), with AddressSanitizer and UndefinedBehaviorSanitizer",
      "cacheVariables": {
        "CMAKE_CXX_FLAGS": "-fsanitize=address,undefined -fno-sanitize-recover=all -fno-omit-frame-pointer",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=address,undefined"
      }
    },
    {
      "name": "macos",
      "inherits": "base",
      "displayName": "macOS (Apple Clang)",
      "generator": "Ninja Multi-Config",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Darwin" }
    }
  ],
  "buildPresets": [
    { "name": "windows-debug", "configurePreset": "windows", "configuration": "Debug" },
    { "name": "windows-release", "configurePreset": "windows", "configuration": "Release" },
    { "name": "linux-debug", "configurePreset": "linux", "configuration": "Debug" },
    { "name": "linux-release", "configurePreset": "linux", "configuration": "Release" },
    { "name": "linux-sanitizers-debug", "configurePreset": "linux-sanitizers", "configuration": "Debug" },
    { "name": "macos-debug", "configurePreset": "macos", "configuration": "Debug" },
    { "name": "macos-release", "configurePreset": "macos", "configuration": "Release" }
  ],
  "testPresets": [
    { "name": "base", "hidden": true, "output": { "outputOnFailure": true }, "execution": { "jobs": 8 } },
    { "name": "unit", "hidden": true, "inherits": "base", "filter": { "include": { "label": "^unit$" } } },
    { "name": "integration", "hidden": true, "inherits": "base", "filter": { "include": { "label": "^integration$" } } },
    { "name": "windows-debug", "inherits": "unit", "configurePreset": "windows", "configuration": "Debug" },
    { "name": "windows-debug-integration", "inherits": "integration", "configurePreset": "windows", "configuration": "Debug" },
    { "name": "windows-debug-all", "inherits": "base", "configurePreset": "windows", "configuration": "Debug" },
    { "name": "windows-release", "inherits": "unit", "configurePreset": "windows", "configuration": "Release" },
    { "name": "windows-release-integration", "inherits": "integration", "configurePreset": "windows", "configuration": "Release" },
    { "name": "windows-release-all", "inherits": "base", "configurePreset": "windows", "configuration": "Release" },
    { "name": "linux-debug", "inherits": "unit", "configurePreset": "linux", "configuration": "Debug" },
    { "name": "linux-debug-integration", "inherits": "integration", "configurePreset": "linux", "configuration": "Debug" },
    { "name": "linux-debug-all", "inherits": "base", "configurePreset": "linux", "configuration": "Debug" },
    { "name": "linux-release", "inherits": "unit", "configurePreset": "linux", "configuration": "Release" },
    { "name": "linux-release-integration", "inherits": "integration", "configurePreset": "linux", "configuration": "Release" },
    { "name": "linux-release-all", "inherits": "base", "configurePreset": "linux", "configuration": "Release" },
    { "name": "linux-sanitizers-debug", "inherits": "unit", "configurePreset": "linux-sanitizers", "configuration": "Debug" },
    { "name": "linux-sanitizers-debug-integration", "inherits": "integration", "configurePreset": "linux-sanitizers", "configuration": "Debug" },
    { "name": "linux-sanitizers-debug-all", "inherits": "base", "configurePreset": "linux-sanitizers", "configuration": "Debug" },
    { "name": "macos-debug", "inherits": "unit", "configurePreset": "macos", "configuration": "Debug" },
    { "name": "macos-debug-integration", "inherits": "integration", "configurePreset": "macos", "configuration": "Debug" },
    { "name": "macos-debug-all", "inherits": "base", "configurePreset": "macos", "configuration": "Debug" },
    { "name": "macos-release", "inherits": "unit", "configurePreset": "macos", "configuration": "Release" },
    { "name": "macos-release-integration", "inherits": "integration", "configurePreset": "macos", "configuration": "Release" },
    { "name": "macos-release-all", "inherits": "base", "configurePreset": "macos", "configuration": "Release" }
  ]
}
